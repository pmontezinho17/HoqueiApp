# macOS
.DS_Store

# Saída gerada — `uv run python -m hoquei.cli despejar` reconstrói em ~40s
data-samples/json/
# Snapshots da sonda: ~80KB cada, centenas por dia de jogos. Os achados ficam nos .jsonl;
# se um snapshot em concreto for prova de algo, copia-o para data-samples/paginas/.
data-samples/sondagem/html/

# o Worker não tem dependências; se o wrangler criar estado local, fica de fora
worker/**/node_modules/
worker/**/.wrangler/

# agentic-project:local-only:start
# Local-only project state. These rules do not remove or untrack existing files.
.secrets/
.scratch/
.tmp/
.env
.env.*
!.env.example
!.env.sample
!.env.template
.direnv/
.venv/
venv/
# agentic-project:local-only:end

# O `svelte-kit sync` cria o `.svelte-kit/` onde quer que seja corrido, e um comando meu
# corrido da raiz em vez de `web/` deixou-o lá — e foi comitado uma vez, a 06/10/2026.
.svelte-kit/

# Gerado pelo `npx wrangler types`: 16 000 linhas de tipos do runtime da Cloudflare, úteis no
# editor e inúteis no repositório. Quem quiser, corre o comando — está no README do observador.
worker/*/worker-configuration.d.ts
