{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "hoquei-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "web",
        "--",
        "--port",
        "5173"
      ],
      "port": 5173
    },
    {
      "name": "hoquei-build",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "preview",
        "--prefix",
        "web",
        "--",
        "--port",
        "4173"
      ],
      "port": 4173
    },
    {
      "name": "hoquei-lan",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "web",
        "--",
        "--host",
        "--port",
        "5174"
      ],
      "port": 5174
    },
    {
      "name": "observador-local",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "--yes",
        "wrangler@4.150.0",
        "dev",
        "--config",
        "worker/observador/wrangler.toml",
        "--port",
        "8787",
        "--var",
        "CHAVE_RONDAS:ensaio-local"
      ],
      "port": 8787
    }
  ]
}
